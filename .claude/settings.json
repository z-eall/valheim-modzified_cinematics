{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ../../.cursor/hooks/guard-publicized-assemblies-freshness.js"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ../../.cursor/hooks/guard-drift-allow.js"
          }
        ],
        "matcher": "Bash|PowerShell"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ../../.cursor/hooks/guard-drift-session-start.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ../../.cursor/hooks/guard-drift-stamp-writer.js"
          }
        ],
        "matcher": "Bash|PowerShell"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ../../.cursor/hooks/guard-drift-session-start.js"
          }
        ]
      }
    ]
  }
}
