{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/../../.claude/hooks/guard-drift-allow.js\""
          }
        ],
        "matcher": "Bash|PowerShell"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/../../.claude/hooks/guard-drift-session-start.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/../../.claude/hooks/guard-drift-stamp-writer.js\""
          }
        ],
        "matcher": "Bash|PowerShell"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/../../.claude/hooks/guard-drift-session-start.js\""
          }
        ]
      }
    ]
  }
}
